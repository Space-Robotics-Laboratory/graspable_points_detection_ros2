{
  "C_Cpp.clang_format_path": "",
  "C_Cpp.clang_format_style": "file:${workspaceFolder}/.clang-format/.clang-format",
  "C_Cpp.default.browse.databaseFilename": "null",
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.loggingLevel": "Error",
  "C_Cpp.workspaceParsingPriority": "low",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "cSpell.ignoreWords": [
    "Eigen",
    "GNUCXX",
    "graspability",
    "insta",
    "LIMBERO",
    "pointcloud",
    "rclcpp",
    "rcpputils",
    "tohoku",
    "voxelization",
    "voxelize",
    "voxelized",
    "Wextra",
    "Wpedantic",
    "XYZRGB",
    "Jitao",
    "Zheng",
    "Ringeval",
    "Meusnier",
    "Antonin",
    "Taku",
    "Okawara",
    "Kentaro",
    "unoken"
  ],
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "all",
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": true,
  "files.associations": {
    "*.tcc": "cpp",
    "algorithm": "cpp",
    "any": "cpp",
    "array": "cpp",
    "atomic": "cpp",
    "bit": "cpp",
    "bitset": "cpp",
